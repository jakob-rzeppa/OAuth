REDIS_URL=redis://auth-server-redis:6379

POSTGRES_USER=auth_server
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auth_server

DATABASE_URL=postgres://auth_server:change-me@auth-server-db:5432/auth_server
# Used by the sqlx CLI from the host (see sqlx.toml). Only reachable with the dev stack.
LOCAL_POSTGRES_URL=postgres://auth_server:change-me@127.0.0.1:5433/auth_server

# Port the app binds to inside its container.
APP_PORT=8080

ACCESS_TOKEN_TTL=3600

# Seconds a login session lives
# Seconds a user session lives
USER_SESSION_TTL=1800 # 30min
# Seconds a pushed authorization request (request_uri) lives
PAR_TTL=180 # 3min
# Seconds an authorization code lives
AUTHORIZATION_CODE_TTL=300 # 5min
# Seconds an ID token is valid. Clients check it once, right after the token response.
ID_TOKEN_TTL=300 # 5min

# Origin (scheme://host[:port]) browsers reach the auth-server under. It is also the issuer
# identifier (`iss`) in authorization responses, introspection and ID tokens. POSTs to /login and
# /authorize from any other origin are rejected. Matches APP_HOST_PORT below in the dev setup.
ISSUER_ORIGIN=https://auth-server.test

# RSA private key (PEM) the ID tokens are signed with. Its public half is served at /jwks.json.
# The compose files mount ./keys at /keys. Generate the key as described in DEV.md.
SIGNING_KEY_PATH=/keys/signing-key.pem

# Minimum log level: debug, info, warn or error.
LOG_LEVEL=info

IDENTITY_PROVIDER_URL=https://identity-provider.test

# Host ports. DB_HOST_PORT and REDIS_HOST_PORT are only published by docker-compose.dev.yml.
REDIS_HOST_PORT=6379
# 5433, so it does not clash with identity-provider's database when both stacks run.
DB_HOST_PORT=5433
# 8081, so it does not clash with identity-provider's 8080 when both stacks run.
APP_HOST_PORT=8081

# The server only answers over https, with this certificate and key. The compose file mounts
# ./certs at /certs (see DEVELOPMENT.md). When running natively, point them at ./certs.
TLS_CERT_PATH=/certs/auth-server.pem
TLS_KEY_PATH=/certs/auth-server-key.pem

# The host's mkcert CA, so clients in the container trust https://*.test. The compose file mounts it
# from MKCERT_CAROOT (see DEVELOPMENT.md). Unset it, or point it at the CA, when running natively.
SSL_CERT_FILE=/ca/rootCA.pem
# Where mkcert keeps its CA (`mkcert -CAROOT`): the macOS default. On Linux export
# MKCERT_CAROOT="$HOME/.local/share/mkcert" in the shell, which takes precedence over this.
MKCERT_CAROOT="${HOME}/Library/Application Support/mkcert"
