POSTGRES_USER=identity_provider
POSTGRES_PASSWORD=change-me
POSTGRES_DB=identity_provider

DATABASE_URL=postgres://identity_provider:change-me@identity-provider-db:5432/identity_provider
# Used by the sqlx CLI from the host (see sqlx.toml). Only reachable with the dev stack.
LOCAL_POSTGRES_URL=postgres://identity_provider:change-me@127.0.0.1:5432/identity_provider

DATABASE_PEPPER=change-me

# The auth-server, which introspects the access tokens presented to this server.
AUTH_SERVER_URL=https://auth-server.test

# The length of temporary passwords - this should be increased in prod.
TEMPORARY_PASSWORD_LENGTH=4

# Port the app binds to inside its container.
APP_PORT=8080

# Minimum log level: debug, info, warn or error.
LOG_LEVEL=debug

# Host ports. DB_HOST_PORT is only published by docker-compose.override.yml.
APP_HOST_PORT=8080
DB_HOST_PORT=5432

# The server only answers over https, with this certificate and key. The compose file mounts
# ./certs at /certs (see DEVELOPMENT.md). When running natively, point them at ./certs.
TLS_CERT_PATH=/certs/identity-provider.pem
TLS_KEY_PATH=/certs/identity-provider-key.pem

# The host's mkcert CA, so clients in the container trust https://*.test. The compose file mounts it
# from MKCERT_CAROOT (see DEVELOPMENT.md). Unset it, or point it at the CA, when running natively.
SSL_CERT_FILE=/ca/rootCA.pem
# Where mkcert keeps its CA (`mkcert -CAROOT`): the macOS default. On Linux export
# MKCERT_CAROOT="$HOME/.local/share/mkcert" in the shell, which takes precedence over this.
MKCERT_CAROOT="${HOME}/Library/Application Support/mkcert"
