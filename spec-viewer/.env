# Read by docker compose, which hands it to the container. The app reads its settings from
# the environment only, so outside of docker set them in the shell.
APP_PORT=8080
APP_HOST_PORT=8090

# host.docker.internal is the host, where `cargo run --example mock_provider` and
# `cargo run --example mock_content` listen.
SPEC_PROVIDER_URL=https://spec-provider.test
CONTENT_STORAGE_URL=http://host.docker.internal:50052

# What is logged: error, warn, info, debug or trace, or per module like spec_viewer=debug.
RUST_LOG=info

# The server only answers over https, with this certificate and key. The compose file mounts
# ./certs at /certs (see DEVELOPMENT.md). When running natively, point them at ./certs.
TLS_CERT_PATH=/certs/spec-viewer.pem
TLS_KEY_PATH=/certs/spec-viewer-key.pem

# The host's mkcert CA, so clients in the container trust https://*.test. The compose file mounts it
# from MKCERT_CAROOT (see DEVELOPMENT.md). Unset it, or point it at the CA, when running natively.
SSL_CERT_FILE=/ca/rootCA.pem
# Where mkcert keeps its CA (`mkcert -CAROOT`): the macOS default. On Linux export
# MKCERT_CAROOT="$HOME/.local/share/mkcert" in the shell, which takes precedence over this.
MKCERT_CAROOT="${HOME}/Library/Application Support/mkcert"
